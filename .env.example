# База и Redis (для локального запуска без Docker — localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrmenu
REDIS_URL=redis://localhost:6379

# Подпись QR-ссылок столов (сменить в проде!)
QR_SIGNING_SECRET=dev-qr-secret-change-me
# Подпись сессий персонала
JWT_SECRET=dev-jwt-secret-change-me

# S3-совместимое хранилище (MinIO локально)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=qrmenu
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_URL=http://localhost:9000/qrmenu

# Адреса приложений
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Telegram-бот (шаг 6)
TELEGRAM_BOT_TOKEN=
